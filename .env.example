# ==============================================================================
# TrustLoop Environment Configuration (.env)
# ==============================================================================

# ---- 1. Database (PostgreSQL with SQLite fallback) ----
# Provide a PostgreSQL connection string to persist runs, answers, audit events,
# and API keys into PostgreSQL. When unset, TrustLoop seamlessly defaults to local SQLite.
#
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/trustloop

# Or specify individual PostgreSQL parameters:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=trustloop
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=YOUR_PASSWORD


# ---- 2. AI & Speech-to-Text Providers (Free Tier / Open Source Models) ----
# Groq provides ultra-fast, free tier inference for Llama 3.3 and Whisper Large v3 speech-to-text.
# Get a free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Alternative for GPT-4o-mini and Whisper-1 speech-to-text):
# Get a key at: https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Deepgram (Optional alternative speech-to-text with $200 free signup credits):
# Get a key at: https://console.deepgram.com
DEEPGRAM_API_KEY=


# ---- 3. Master Developer API Key ----
# Master API authentication token for TrustLoop REST API (/api/v1/*).
# In addition, you can generate dynamic, revocable client API keys from the UI dashboard!
TRUSTLOOP_API_KEY=


# ---- 4. Optional Integrations ----
# Slack incoming webhook URL for delivery notifications:
SLACK_WEBHOOK_URL=
